<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,NC]
</IfModule>

# ==========================================
# BLOQUEO DE SEGURIDAD LARAVEL (CRÍTICO)
# ==========================================
<FilesMatch "^\.env|composer\.json|package\.json|phpunit\.xml">
    Require all denied
</FilesMatch>
<DirectoryMatch "^/(app|bootstrap|config|database|resources|routes|storage|tests|vendor)/">
    Require all denied
</DirectoryMatch>
