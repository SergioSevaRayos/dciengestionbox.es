<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    
    <title>DCIEN | Software de Gestión para Gimnasios y Box de Crossfit</title>
    <meta name="description" content="La plataforma más potente y simple para gestionar tu centro deportivo. Calendario versátil, control de aforos, marcas personales y marca blanca total.">
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&display=swap" rel="stylesheet">
    <style>
        html { scroll-behavior: smooth; }
        body { font-family: 'Inter', sans-serif; background-color: #000; color: #fff; overflow-x: hidden; }
        .text-gradient { 
            background: linear-gradient(to right, #fff, #a1a1a1); 
            -webkit-background-clip: text; 
            -webkit-text-fill-color: transparent;
            display: inline-block; 
            padding-right: 40px; 
            margin-right: -40px;
        }
        .feature-card { 
            border: 1px solid rgba(255,255,255,0.05); 
            background: #050505; 
            transition: all 0.4s ease; 
            display: flex; 
            flex-direction: column; 
            overflow: hidden; 
            height: 100%;
        }
        .feature-card:hover { 
            border-color: rgba(245, 158, 11, 0.5); 
            transform: translateY(-5px); 
            box-shadow: 0 10px 30px -10px rgba(245,158,11,0.1); 
        }
        .img-container-pc { 
            width: 100%; aspect-ratio: 16/9; overflow: hidden; 
            filter: grayscale(100%) brightness(0.4); transition: all 0.5s ease;
            border-bottom: 1px solid rgba(255,255,255,0.05);
        }
        .feature-card:hover .img-container-pc { filter: grayscale(0%) brightness(0.9); }
        .img-pc { width: 100%; height: 100%; object-fit: cover; }
        
        .mockup-glow {
            box-shadow: 0 0 80px -20px rgba(245, 158, 11, 0.15);
            transition: all 0.5s ease;
        }
        .mockup-glow:hover {
            box-shadow: 0 0 120px -20px rgba(245, 158, 11, 0.3);
            transform: translateY(-5px);
        }
    </style>
    <link rel="icon" type="image/png" href="/favicon.png?v=3">
</head>
