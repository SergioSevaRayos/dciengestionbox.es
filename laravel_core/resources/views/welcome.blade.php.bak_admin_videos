        <div class="hidden md:flex items-center gap-10">
            <a href="/app/login" class="hover:text-gray-400 transition uppercase tracking-[0.2em] text-[10px] font-bold">Alumnos</a>
            <a href="/admin/login" class="hover:text-gray-400 transition uppercase tracking-[0.2em] text-[10px] font-bold">Gestores</a>
